[Unit]
Description=Creative Intelligence background worker (persistent jobs)
After=network-online.target creative-intelligence.service
Wants=network-online.target

[Service]
Type=simple
User=creative-intel
Group=creative-intel
WorkingDirectory=/opt/creative-intelligence
EnvironmentFile=/etc/creative-intelligence/creative-intelligence.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/creative-intelligence/.venv/bin/python /opt/creative-intelligence/Backend/ci_backend/worker.py --db /var/lib/creative-intelligence/creative_intel.db --poll 5
Restart=always
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/creative-intelligence /opt/creative-intelligence

[Install]
WantedBy=multi-user.target
