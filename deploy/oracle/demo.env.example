# Free demo configuration template (Oracle Always Free + DuckDNS).
# Copy to /etc/creative-intelligence/creative-intelligence.env and chmod 600.
# Fill in the empty values on the VM only. NEVER commit real secrets.
#
# Domain migration later (e.g. to creative.foap.com) only needs: DNS,
# DOMAIN, the two redirect URIs below, and a new certificate.

CREATIVE_INTEL_ENVIRONMENT=demo
CREATIVE_INTEL_COOKIE_SECURE=true
CREATIVE_INTEL_PROVIDER_MODE=live

CREATIVE_INTEL_ADMIN_EMAIL=
CREATIVE_INTEL_WORKOS_CLIENT_ID=
CREATIVE_INTEL_KEY_WORKOS=
CREATIVE_INTEL_WORKOS_REDIRECT_URI=https://foap-creative.duckdns.org/api/auth/callback

CREATIVE_INTEL_GOOGLE_CLIENT_ID=
CREATIVE_INTEL_GOOGLE_CLIENT_SECRET=
CREATIVE_INTEL_GOOGLE_REDIRECT_URI=https://foap-creative.duckdns.org/api/auth/google/callback

# Server master key for encrypted OAuth refresh storage (generate with
# `python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`).
CREATIVE_INTEL_MASTER_KEY=

# Live AI provider keys: add only the providers you enable. At least one
# STT, one vision, and one LLM adapter must be present (see
# /api/providers/status once deployed).
# CREATIVE_INTEL_KEY_DEEPGRAM=
# CREATIVE_INTEL_KEY_GROQ_STT=
# CREATIVE_INTEL_KEY_GEMINI=
# CREATIVE_INTEL_KEY_NVIDIA=
# CREATIVE_INTEL_KEY_OPENAI=
# CREATIVE_INTEL_KEY_ANTHROPIC=
# CREATIVE_INTEL_KEY_ZAI=
# CREATIVE_INTEL_KEY_DEEPSEEK=
# CREATIVE_INTEL_KEY_MOONSHOT=
# CREATIVE_INTEL_KEY_XAI=
