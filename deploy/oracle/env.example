# Copy to /etc/creative-intelligence/creative-intelligence.env and chmod 600.
# Never commit real values.

CREATIVE_INTEL_DATA_DIR=/var/lib/creative-intelligence
CREATIVE_INTEL_MEDIA_DIR=/var/lib/creative-intelligence/media
CREATIVE_INTEL_COOKIE_SECURE=true

# First administrator. Only this verified WorkOS email may bootstrap the first admin.
CREATIVE_INTEL_ADMIN_EMAIL=replace-me@example.com

# Hourly scheduled connector sync (seconds; 0 disables the scheduler).
# The systemd service passes no CLI flags, so this is the switch.
# CREATIVE_INTEL_SYNC_EVERY=3600

# WorkOS authentication
CREATIVE_INTEL_WORKOS_CLIENT_ID=
CREATIVE_INTEL_KEY_WORKOS=
CREATIVE_INTEL_WORKOS_REDIRECT_URI=https://creative-intelligence.duckdns.org/api/auth/callback

# Optional private Google Drive/Sheets OAuth
CREATIVE_INTEL_GOOGLE_CLIENT_ID=
CREATIVE_INTEL_GOOGLE_CLIENT_SECRET=
CREATIVE_INTEL_GOOGLE_REDIRECT_URI=https://creative-intelligence.duckdns.org/api/auth/google/callback

# Optional live provider credentials used by Creative Intelligence.
# Add only the providers you actually enable. Keep all secrets server-side.
# CREATIVE_INTEL_KEY_META=
# CREATIVE_INTEL_KEY_TIKTOK=
# CREATIVE_INTEL_KEY_OPENAI=

# Off-host backup copy (rsync destination or mounted bucket path).
# Empty means off-host copy is skipped; on-host backups still run daily.
# BACKUP_OFFHOST_DEST=backup@vault.example:/srv/creative-intelligence
# BACKUP_OFFHOST_KEEP=14

# Backup encryption + retention. The passphrase never leaves this file
# and the operator shell: archives are AES-256-CBC encrypted before any
# off-host transfer, and plaintext archives are refused off-host once it
# is set (generate: openssl rand -base64 32). REQUIRED when
# CREATIVE_INTEL_ENVIRONMENT=production (backup refuses plaintext).
# BACKUP_ENCRYPTION_PASSPHRASE=
# BACKUP_KEEP_DAILY=14
